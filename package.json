{
  "name": "truckcar-frontend",
  "private": true,
  "description": "App PWA y Móvil Android de TruckCar (HTML, CSS y JavaScript). El paso de construcción es el CSS de Tailwind (npm run build:css); empaquetable como APK con Capacitor.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.input.css -o css/tailwind.css --minify",
    "check": "node scripts/check-syntax.mjs",
    "check:links": "node scripts/check-doc-links.mjs",
    "lint": "eslint .",
    "test": "node --test test/",
    "ci": "npm run check && npm run lint && npm test",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "build:apk": "cap sync android && node scripts/inject-config.mjs android/app/src/main/assets/public/index.html --require-url --require-https"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@eslint/js": "9.14.0",
    "eslint": "9.14.0",
    "fake-indexeddb": "6.0.0",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=20"
  }
}
